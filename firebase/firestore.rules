rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['admin', 'phi'];
    }

    // Incoming data must not touch the given set of protected field names at all.
    function doesNotAffect(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // The incoming timestamp must be very close to server time to prevent
    // clients injecting back-dated timestamps.
    function isRecentTimestamp(ts) {
      return ts == request.time;
    }

    // ─── Users ───────────────────────────────────────────────────────────────

    match /users/{userId} {
      // A user may only read their own profile; admins/PHIs see all.
      allow read: if isOwner(userId) || isAdmin();

      // Profile creation is ONLY authoritative: done by the onUserCreated Cloud
      // Function with an admin SDK token that bypasses client rules entirely.
      allow create: if false;

      // Users may update display-name, district, fcmTokens, and
      // notificationPreferences only. They can NEVER touch privilege or
      // gamification fields.
      allow update: if isOwner(userId)
                    && doesNotAffect([
                         'totalPoints',
                         'verifiedReportsCount',
                         'badges',
                         'role',
                         'uid',
                         'email',
                         'createdAt',
                       ]);

      // Deletion only through admin SDK (server-side); clients cannot delete profiles.
      allow delete: if isAdmin();
    }

    // ─── Reports ─────────────────────────────────────────────────────────────

    match /reports/{reportId} {
      // A citizen sees their own reports.
      // Approved/verified reports are visible to all authenticated users for
      // the public map and community hazard feed. Admins see everything.
      allow read: if isAuthenticated() && (
        resource.data.get('reporterId', '') == request.auth.uid ||
        resource.data.get('status', '') in ['approved', 'verified', 'in_progress', 'still_present', 'resolved'] ||
        isAdmin()
      );

      // A citizen may submit a new report ONLY with:
      //  - their own uid as the reporter
      //  - status locked to 'pending'
      //  - zero points (server awards these)
      //  - no isApproved or reviewer fields
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.pointsAwarded == 0
                    && !('isApproved' in request.resource.data)
                    && !('reviewedBy' in request.resource.data)
                    && !('reviewedAt' in request.resource.data);

      // Status transitions, point awards, and deletions are ADMIN/PHI only.
      // Regular citizens CANNOT approve, reject, or modify points.
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // ── Observations subcollection (duplicate follow-ups) ─────────────────
      match /observations/{observationId} {
        // A citizen may read their own observation; admins see all.
        allow read: if isAuthenticated() &&
                    (resource.data.get('reporterId', '') == request.auth.uid || isAdmin());
        // Observations are written only by Cloud Functions (admin SDK).
        allow create, update, delete: if false;
      }
    }

    // ─── Points Transactions Ledger ───────────────────────────────────────────
    // Immutable; written only by server-side Cloud Functions.

    match /pointsTransactions/{transactionId} {
      allow read:  if isAuthenticated() &&
                   (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // ─── Rewards Catalog ─────────────────────────────────────────────────────

    match /rewards/{rewardId} {
      // Any authenticated user may browse the catalog.
      allow read:  if isAuthenticated();
      // Only admins may create / edit / remove rewards.
      allow write: if isAdmin();

      // ── Coupons subcollection ─────────────────────────────────────────────
      // Coupon codes are NEVER readable by an arbitrary user.
      // A user can only read a coupon that has been definitively assigned to
      // them (redeemedBy == their uid). This prevents fishing for unused codes.
      match /coupons/{couponId} {
        allow read: if isAuthenticated() &&
                    resource.data.isRedeemed == true &&
                    resource.data.redeemedBy == request.auth.uid;
        // Coupons can only be created/managed by admins directly, or via admin SDK Cloud Functions
        allow write: if isAdmin();
      }
    }

    // ─── Redemptions History ─────────────────────────────────────────────────

    match /redemptions/{redemptionId} {
      allow read:  if isAuthenticated() &&
                   (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // ─── Historical Epidemiology Data ────────────────────────────────────────

    match /historicalEpidemiology/{recordId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /historicalDatasets/{datasetId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Risk Summaries ───────────────────────────────────────────────────────

    match /riskSummaries/{district} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();

      match /versions/{versionId} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /riskMetadata/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Deny-all fallback ────────────────────────────────────────────────────
    // Any collection not explicitly listed above is completely locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
