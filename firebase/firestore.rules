rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['admin', 'phi'];
    }

    // User profiles collection
    match /users/{userId} {
      // Users can only read their own profile; admins/PHIs can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // Users CANNOT create their profile directly (authoritatively created via onUserCreated Cloud Function)
      allow create: if false;

      // Users can update basic profile info, but can NEVER tamper with points or privileges
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'totalPoints',
                      'verifiedReportsCount',
                      'badges',
                      'role',
                      'uid'
                    ]);

      allow delete: if isAdmin();
    }

    // Reports collection
    match /reports/{reportId} {
      // Users can read their own reports; authenticated users can read approved public reports for the live map; admins can read all
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        resource.data.status in ['approved', 'verified'] ||
        isAdmin()
      );

      // Creation will be enabled in Section D (client writes new reports with status='pending')
      // Points and status updates can NEVER be directly written by regular users
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.pointsAwarded == 0;

      allow update, delete: if isAdmin();

      // Observations subcollection (duplicates/follow-ups)
      match /observations/{observationId} {
        allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // Immutable Points Transactions Ledger
    match /pointsTransactions/{transactionId} {
      // Users can only read their own transactions; admins/PHIs can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Writable ONLY via server-side Cloud Functions (transactions)
      allow write: if false;
    }

    // Rewards Catalog & Coupons
    match /rewards/{rewardId} {
      // Authenticated users can browse the reward shop
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Coupons Subcollection: coupon codes are never readable except the assigned user's own redemption
      match /coupons/{couponId} {
        allow read: if isAuthenticated() && resource.data.redeemedBy == request.auth.uid;
        allow write: if false;
      }
    }

    // User Redemptions History
    match /redemptions/{redemptionId} {
      // Users can only read their own redemptions; admins/PHIs can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Writable ONLY via server-side Cloud Function (redeemReward)
      allow write: if false;
    }

    // Historical Epidemiology Data (Epid.gov.lk official figures or synthetic benchmarks)
    match /historicalEpidemiology/{recordId} {
      // Authenticated users can read aggregated historical trend data
      allow read: if isAuthenticated();
      // Writable ONLY by authorized admins or PHI officers
      allow write: if isAdmin();
    }

    // Historical Datasets Audit & Provenance Records
    match /historicalDatasets/{datasetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny-all for all other documents until each respective feature is built
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
